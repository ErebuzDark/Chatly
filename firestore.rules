rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isBlocked(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/blocks/$(uid2))
          || exists(/databases/$(database)/documents/users/$(uid2)/blocks/$(uid1));
    }

    function isContact(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/contacts/$(uid2));
    }

    // 1. Username -> UID reservation. Readable one-by-one, never listable.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(request.resource.data.uid)
                    && name.matches('^[a-z0-9_.]{3,20}$');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 2. User profiles & subcollections
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.usernameLower.matches('^[a-z0-9_.]{3,20}$')
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 50
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow update: if (isOwner(uid)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.username == resource.data.username
                        && request.resource.data.usernameLower == resource.data.usernameLower)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stories']));
      allow delete: if isOwner(uid);

      // Wall / status posts
      match /posts/{postId} {
        allow read: if signedIn()
                    && (isOwner(uid)
                        || !get(/databases/$(database)/documents/users/$(uid)).data.isPrivate
                        || isContact(uid, request.auth.uid));
        allow create, delete: if isOwner(uid);
        // Owner can update anything; other signed-in viewers can only update `likes`
        allow update: if isOwner(uid)
                      || (signedIn()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      }

      // Contacts subcollection (mutual add/remove supported in batch)
      match /contacts/{targetUid} {
        allow read: if isOwner(uid) || isOwner(targetUid);
        allow create, update: if (isOwner(uid) || isOwner(targetUid))
                              && !isBlocked(uid, targetUid);
        allow delete: if isOwner(uid) || isOwner(targetUid);
      }

      // Blocks subcollection
      match /blocks/{targetUid} {
        allow read: if isOwner(uid) || isOwner(targetUid);
        allow create, update, delete: if isOwner(uid);
      }
    }

    // 3. Contact requests ({fromUid}_{toUid})
    match /contactRequests/{requestId} {
      allow read: if signedIn()
                  && (resource == null
                      || resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && !isBlocked(request.resource.data.fromUid, request.resource.data.toUid);
      allow update: if signedIn()
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid);
      allow delete: if signedIn()
                    && (resource == null
                        || resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid);
    }

    // 4. User reports (create-only by reporter)
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // 5. Chats (1:1 direct and group conversations)
    match /chats/{chatId} {
      allow read: if signedIn()
                  && (resource == null
                      || request.auth.uid in resource.data.memberIds
                      || resource.data.inviteEnabled == true);

      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn()
                    && (
                      // Existing member updating chat metadata, read receipts, typing, or group info
                      request.auth.uid in resource.data.memberIds
                      // Or joining an invite-enabled group via invite link
                      || (resource.data.type == 'group'
                          && resource.data.inviteEnabled == true
                          && request.auth.uid in request.resource.data.memberIds)
                    );

      allow delete: if false;

      // Messages inside a chat
      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        allow create: if signedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;

        allow update: if signedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
                      && (
                        // Sender editing or unsending their own message
                        resource.data.senderId == request.auth.uid
                        // Any member reacting, voting in a poll, or deleting for themselves
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'deletedFor', 'poll'])
                      );

        allow delete: if false;
      }
    }
  }
}
